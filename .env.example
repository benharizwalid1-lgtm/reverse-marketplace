# Neon / Vercel Postgres pooled URL (used by the app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct (non-pooled) URL for Prisma migrations. Same as DATABASE_URL if you only have one.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# At least 32 characters. Required in production.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Optional. If set, photos go to Vercel Blob instead of inline data URLs.
# BLOB_READ_WRITE_TOKEN=""
